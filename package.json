{
  "name": "netlab-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-based network topology designer and educational simulator",
  "author": "Advance Tech Club of NIAT College",
  "homepage": "https://github.com/netlab-studio/netlab-studio",
  "type": "module",
  "main": "electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "desktop:dev": "VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron electron/main.cjs",
    "desktop:build:web": "npm run build",
    "desktop:pack": "npm run desktop:build:web && electron-builder --dir",
    "desktop:dist:deb": "npm run desktop:build:web && electron-builder --linux deb",
    "desktop:dist:win": "npm run desktop:build:web && electron-builder --win nsis",
    "desktop:dist": "npm run desktop:build:web && electron-builder --linux deb --win nsis"
  },
  "build": {
    "appId": "studio.netlab.desktop",
    "productName": "NetLab Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Education",
      "maintainer": "Advance Tech Club of NIAT College",
      "icon": "public/icons"
    },
    "deb": {
      "artifactName": "netlab-studio_${version}_${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "netlab-studio_${version}_${arch}.${ext}"
    }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
